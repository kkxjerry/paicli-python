PAICLI_API_KEY=replace-me
PAICLI_MODEL=glm-4-flash
PAICLI_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# Shell execution is disabled by default. Prefer the --allow-shell flag when
# you intentionally want to expose execute_command to the model.
PAICLI_ALLOW_SHELL=false

# Phase 8 provider factory. Set only the provider you use.
GLM_API_KEY=
GLM_MODEL=glm-4-flash
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
STEPFUN_API_KEY=
STEPFUN_MODEL=step-2-16k
KIMI_API_KEY=
KIMI_MODEL=kimi-k2

# A40 vLLM binds to server localhost. Open an SSH tunnel to local port 18000.
# VLLM_API_KEY is optional because the endpoint is not exposed to the network.
VLLM_BASE_URL=http://127.0.0.1:18000/v1
VLLM_MODEL=Qwen/Qwen3.5-9B
VLLM_API_KEY=
