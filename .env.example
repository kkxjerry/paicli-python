# PaiCLI model provider. Copy this file to .env and fill only the provider you use.
# Never commit .env or print a real API key in logs.

# Alibaba Cloud Model Studio / DashScope (recommended first integration)
DASHSCOPE_API_KEY=
DASHSCOPE_MODEL=qwen-plus
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_CONTEXT_WINDOW=131072
DASHSCOPE_TIMEOUT_SECONDS=120

# Other OpenAI-compatible providers
GLM_API_KEY=
GLM_MODEL=glm-4-flash
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

STEPFUN_API_KEY=
STEPFUN_MODEL=step-2-16k
STEPFUN_BASE_URL=https://api.stepfun.com/v1

KIMI_API_KEY=
KIMI_MODEL=kimi-k2
KIMI_BASE_URL=https://api.moonshot.cn/v1

# A40/local vLLM through an SSH tunnel. VLLM_API_KEY may stay empty when the
# server has no API-key requirement.
VLLM_BASE_URL=http://127.0.0.1:18000/v1
VLLM_MODEL=Qwen/Qwen3.5-9B
VLLM_API_KEY=
VLLM_CONTEXT_WINDOW=32768

# Generic OpenAI-compatible fallback used when --provider is omitted.
PAICLI_API_KEY=
PAICLI_MODEL=
PAICLI_BASE_URL=
PAICLI_CONTEXT_WINDOW=128000
PAICLI_TIMEOUT_SECONDS=120

# Local runtime state. CLI flags take precedence when supplied.
PAICLI_ALLOW_SHELL=false
PAICLI_MEMORY_FILE=
PAICLI_TRACE_FILE=

# Optional pricing configuration. Values are CNY per one million tokens.
# Prices change over time, so PaiCLI never hard-codes them. Set verified values
# for the exact provider/model you run; otherwise reports mark calls unpriced.
PAICLI_PRICE_DASHSCOPE_QWEN_PLUS_INPUT_CNY_PER_MILLION=
PAICLI_PRICE_DASHSCOPE_QWEN_PLUS_OUTPUT_CNY_PER_MILLION=
PAICLI_PRICE_DASHSCOPE_QWEN_PLUS_CACHED_CNY_PER_MILLION=0

# Opt-in real-model tests. They are intentionally excluded from normal CI.
PAICLI_RUN_DASHSCOPE_LIVE_TEST=0
PAICLI_RUN_VLLM_LIVE_TEST=0
